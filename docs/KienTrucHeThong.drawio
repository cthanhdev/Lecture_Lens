        <mxCell id="leg-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="972" width="580" height="48" as="geometry" />
        </mxCell>
        <mxCell id="leg-ing" value="&lt;b style=&quot;color:#FFFFFF; font-size:11px;&quot;&gt;Ingest (offline)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;arcSize=35;" vertex="1" parent="1">
          <mxGeometry x="975" y="982" width="115" height="28" as="geometry" />
        </mxCell>
