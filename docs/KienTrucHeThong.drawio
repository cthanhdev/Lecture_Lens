                <mxCell id="llm-gemma" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.8;arcSize=12;spacing=6;verticalAlign=top;" value="&lt;b style=&quot;font-size:12px; color:#166534;&quot;&gt;✨ [Q5]–[Q7+] Gemma 4 E4B ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px; color:#0F172A;&quot;&gt;&lt;b&gt;Multi-Pass Chain (/rag/query)&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:9.8px; color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;[Q5] Pass 1 Draft:&lt;/b&gt; Bám sát Top K [MM:SS]&lt;br/&gt;&amp;bull; &lt;b&gt;[Q6] Pass 2 Refiner:&lt;/b&gt; Custom System Prompt (sửa chữ + format text|json)&lt;br/&gt;&amp;bull; &lt;b&gt;[Q7+] extraStages:&lt;/b&gt; Chuỗi mở rộng&lt;br/&gt;&amp;bull; &lt;i&gt;CompositeLLMClient&lt;/i&gt; + unload() VRAM&lt;/div&gt;" vertex="1">
                    <mxGeometry height="216" width="191" x="1312" y="544" as="geometry" />
                </mxCell>
