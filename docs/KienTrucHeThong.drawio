        <mxCell id="ai-i3" value="&lt;b style=&quot;font-size:11px; color:#0F172A;&quot;&gt;✂️ VAD Slice ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;[I3] EnergyVad&lt;br/&gt;RMS 50ms (-38dB)&lt;br/&gt;Cắt khoảng nghỉ&lt;br/&gt;10s &amp;ndash; 28s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.2;arcSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="409" y="566" width="98" height="132" as="geometry" />
        </mxCell>
        <mxCell id="ai-i4" value="&lt;b style=&quot;font-size:11px; color:#0F172A;&quot;&gt;🤗 PhoWhisper ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;[I4] base/medium&lt;br/&gt;GPU Lock(1), STT&lt;br/&gt;Gán [MM:SS] + unload()&lt;br/&gt;&amp;rarr; transcript.json&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=12;spacing=4;" vertex="1" parent="1">
