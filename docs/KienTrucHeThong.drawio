        <mxCell id="llm-models" value="&lt;b style=&quot;font-size:11px; color:#166534;&quot;&gt;📦 Local Models (~23.7 GB) ✅&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155;&quot;&gt;&amp;bull; phowhisper-base/medium ✅&lt;br/&gt;&amp;bull; bge-m3 + sparse_linear.pt ✅&lt;br/&gt;&amp;bull; bge-reranker-v2-m3 (2.27 GB) ⏸️&lt;br/&gt;&amp;bull; gemma-4-e4b (15.88 GB) ⏸️&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.2;arcSize=12;spacing=6;verticalAlign=top;" vertex="1" parent="1">
