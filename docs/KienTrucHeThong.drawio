        <!-- CỘT GIỮA TRONG DOCKER: POSTGRESQL + PGVECTOR                         -->
        <!-- =================================================================== -->
        <mxCell id="db-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="945" y="480" width="290" height="408" as="geometry" />
        </mxCell>
        <mxCell id="db-hdr" value="&lt;b style=&quot;font-size:14px; color:#0F172A;&quot;&gt;🐘 PostgreSQL + pgvector&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#0369A1;&quot;&gt;Container: db (:5432) &amp;bull; PG16 + 0.7.0+&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="955" y="486" width="270" height="44" as="geometry" />
        </mxCell>

        <mxCell id="db-app" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Schema app ✅ (Migration 06)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;app.users &amp;bull; app.lectures &amp;bull; app.jobs&lt;br/&gt;(Constraint 7 trạng thái có STT_COMPLETED)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=1.5;arcSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="962" y="538" width="256" height="86" as="geometry" />
        </mxCell>

        <mxCell id="db-rag" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Schema rag ✅ (CompositeChunkStore ✅)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;rag.lecture_chunks:&lt;/b&gt; halfvec(1024), HNSW (m=16, ef=64), GIN tsv_content, GIN pg_trgm unaccent, format_timestamp_display() [MM:SS] IMMUTABLE, prev/next_chunk_id&lt;br/&gt;&amp;bull; &lt;b&gt;search_vietnamese_rag_rrf():&lt;/b&gt; 3-Stream Hybrid RRF &amp;rarr; Top 25&lt;br/&gt;&amp;bull; &lt;b&gt;get_expanded_context():&lt;/b&gt; &quot;position&quot; PREV/CURR/NEXT&lt;br/&gt;&amp;bull; &lt;b&gt;semantic_query_cache&lt;/b&gt; &amp;amp; &lt;b&gt;rag_audit_logs&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=1.5;arcSize=12;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="962" y="636" width="256" height="238" as="geometry" />
        </mxCell>

