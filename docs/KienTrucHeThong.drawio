      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TRANG 2: CHI TIẾT TỪNG STEP & MATT POCOCK DEEP MODULE SEAMS               -->
  <!-- ========================================================================= -->
  <diagram id="steps-and-seams" name="2. Chi Tiết Từng Step &amp; Deep Modules">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1160" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Canvas -->
        <mxCell id="p2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="1660" height="1140" as="geometry" />
        </mxCell>

        <!-- Banner Trang 2 -->
        <mxCell id="p2-banner" value="&lt;b style=&quot;font-size:19px; color:#0F172A;&quot;&gt;🔍 Chi Tiết Từng Step Xử Lý Backend &amp;amp; Kiến Trúc Deep Module Seams&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px; color:#475569;&quot;&gt;Phân tích bằng Understand Anything (.ua/manifest.json) &amp;amp; Matt Pocock Skills (codebase-design + domain-modeling)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1620" height="60" as="geometry" />
        </mxCell>

        <!-- =================================================================== -->
        <!-- BAND 1: LUỒNG 1 - OFFLINE INGESTION (STEP 1 .. STEP 8)               -->
        <!-- =================================================================== -->
        <mxCell id="b1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;arcSize=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="1620" height="385" as="geometry" />
        </mxCell>
        <mxCell id="b1-hdr" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;LUỒNG 1 — OFFLINE AUDIO INGEST &amp;amp; VECTORIZATION PIPELINE (STEP 1 &amp;rarr; STEP 8)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="106" width="1580" height="28" as="geometry" />
        </mxCell>

        <!-- Row 1: Step 1..4 -->
        <mxCell id="s1" value="&lt;b style=&quot;color:#991B1B; font-size:12px;&quot;&gt;Step 1: Client Upload &amp;amp; Cấp jobId 🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Mobile gửi &lt;b&gt;POST /api/v1/audio/upload&lt;/b&gt; (audio, lectureId, fileExtension) kèm Bearer JWT.&lt;br/&gt;&amp;bull; Gateway sinh UUID v4 &lt;i&gt;jobId&lt;/i&gt;, ghi &lt;i&gt;app.jobs (QUEUED)&lt;/i&gt;, trả &lt;b&gt;202 Accepted&lt;/b&gt;.&lt;br/&gt;&amp;bull; &lt;i&gt;Dev hiện tại:&lt;/i&gt; &lt;b&gt;TEST/server.py (:8090)&lt;/b&gt; nhận upload qua &lt;i&gt;POST /api/upload&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="146" width="375" height="148" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b style=&quot;color:#0F766E; font-size:12px;&quot;&gt;Step 2: Volume Handshake &amp;amp; Secret Gate ✅/🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Gateway ghi nguyên tử &lt;i&gt;{jobId}.tmp &amp;rarr; ingest/incoming/{jobId}.{ext}&lt;/i&gt; (ADR 0002).&lt;br/&gt;&amp;bull; Gọi &lt;b&gt;POST /internal/v1/ai/ingest&lt;/b&gt; chỉ truyền &lt;i&gt;{jobId, lectureId, fileExtension}&lt;/i&gt; (cấm path tùy ý).&lt;br/&gt;&amp;bull; FastAPI &lt;b&gt;verify_internal_secret()&lt;/b&gt; kiểm tra &lt;i&gt;X-Internal-Secret&lt;/i&gt; bằng &lt;i&gt;secrets.compare_digest&lt;/i&gt; (401/422/404/202) &amp;rarr; đẩy vào &lt;i&gt;BackgroundTasks&lt;/i&gt; ✅.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="451" y="146" width="375" height="148" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 3: AudioStore Register &amp;amp; Manifest O(1) ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;IngestPipelineCoordinator&lt;/b&gt; báo &lt;i&gt;PROCESSING_STT (5%)&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;LocalVolumeAudioStore.register()&lt;/b&gt; chặn Path Traversal (&lt;i&gt;relative_to&lt;/i&gt;), kiểm tra file tồn tại &amp;amp; &amp;gt;0 bytes, tính SHA-256.&lt;br/&gt;&amp;bull; Ghi nguyên tử &lt;i&gt;audio/{jobId}/manifest.json&lt;/i&gt; (&lt;i&gt;mkstemp&lt;/i&gt; cùng thư mục + &lt;i&gt;fsync&lt;/i&gt; + &lt;i&gt;os.replace&lt;/i&gt; tránh lỗi &lt;i&gt;EXDEV&lt;/i&gt;).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="852" y="146" width="375" height="148" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 4: FFmpeg DSP &amp;amp; Chuẩn Hóa 16kHz PCM ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Báo tiến độ &lt;i&gt;PROCESSING_STT (15%)&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;FFmpegAudioPreprocessor.process()&lt;/b&gt; tự dò binary (&lt;i&gt;FFMPEG_BINARY &amp;rarr; PATH &amp;rarr; imageio_ffmpeg&lt;/i&gt;).&lt;br/&gt;&amp;bull; Chạy filter DSP: &lt;i&gt;highpass=80, lowpass=7500, afftdn=nf=-25:tn=1, loudnorm=I=-16:TP=-1.5:LRA=11&lt;/i&gt; &amp;rarr; xuất &lt;b&gt;normalized.wav&lt;/b&gt; (16kHz Mono 16-bit).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1253" y="146" width="375" height="148" as="geometry" />
        </mxCell>

        <!-- Row 2: Step 5..8 -->
        <mxCell id="s5" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 5: GPU Lock, VAD Slicing &amp;amp; PhoWhisper ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Khóa &lt;b&gt;GLOBAL_GPU_SEMAPHORE(1)&lt;/b&gt; chống OOM VRAM, chạy đồng bộ trong &lt;i&gt;loop.run_in_executor&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;EnergyVadChunker:&lt;/b&gt; quét RMS 50ms (-38dB), cắt tại khoảng lặng &amp;ge;300ms (10s&amp;ndash;28s) (đã dùng trong &lt;i&gt;TEST/server.py&lt;/i&gt;; &lt;i&gt;PhoWhisperEngine&lt;/i&gt; mặc định cắt 30s nếu không truyền).&lt;br/&gt;&amp;bull; &lt;b&gt;PhoWhisperEngine:&lt;/b&gt; &lt;i&gt;DEFAULT_IT_PROMPT&lt;/i&gt;, &lt;i&gt;no_repeat_ngram_size=3&lt;/i&gt;, &lt;i&gt;empty_cache()&lt;/i&gt;, báo 25%&amp;rarr;85%.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="316" width="375" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 6: Xuất transcript.json &amp;amp; STT_COMPLETED ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Báo &lt;i&gt;90%&lt;/i&gt;, gán nhãn &lt;b&gt;[MM:SS]&lt;/b&gt; tăng đơn điệu (&lt;i&gt;format_timestamp_label()&lt;/i&gt;).&lt;br/&gt;&amp;bull; &lt;b&gt;AudioStore.save_transcript()&lt;/b&gt; ghi nguyên tử &lt;i&gt;transcripts/{jobId}/transcript.json&lt;/i&gt;, cập nhật &lt;i&gt;manifest.stt = COMPLETED&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;SpringJobReporter&lt;/b&gt; retry 3 lần (backoff 0.5s&amp;rarr;2s) gọi &lt;i&gt;PUT /internal/v1/jobs/{jobId}/status&lt;/i&gt; báo &lt;b&gt;STT_COMPLETED (100%)&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;strokeWidth=2;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="451" y="316" width="375" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 7: Recursive Chunking &amp;amp; BGE-M3 Embed ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Giải phóng VRAM &lt;b&gt;asr_engine.unload()&lt;/b&gt; (&lt;i&gt;LOW_VRAM_MODE=true&lt;/i&gt;), đọc &lt;i&gt;transcript.json&lt;/i&gt;, báo &lt;b&gt;CHUNKING (88%)&lt;/b&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;[I5] RecursiveTokenChunker&lt;/b&gt; (&lt;i&gt;BgeM3TokenizerAdapter&lt;/i&gt;): gom chunks &amp;le; &lt;b&gt;512 tokens&lt;/b&gt; (64 overlap), nội suy &lt;i&gt;[MM:SS]&lt;/i&gt;, nối &lt;i&gt;prev/next_chunk_id&lt;/i&gt;.&lt;br/&gt;&amp;bull; Báo &lt;b&gt;EMBEDDING (92%)&lt;/b&gt; &amp;rarr; &lt;b&gt;[I6] BgeM3Embedder&lt;/b&gt; (&lt;i&gt;transformers + sparse_linear.pt&lt;/i&gt;) sinh &lt;b&gt;halfvec(1024)&lt;/b&gt; + &lt;i&gt;lexical_weights&lt;/i&gt; JSONB.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="852" y="316" width="375" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 8: Lưu chunks.json, Batch Sync pgvector &amp;amp; READY ✅&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;AudioStore.save_chunks()&lt;/b&gt; ghi nguyên tử &lt;i&gt;chunks/{jobId}/chunks.json&lt;/i&gt;, cập nhật &lt;i&gt;manifest.chunking&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;CompositeChunkStore&lt;/b&gt; batch upsert vào &lt;b&gt;rag.lecture_chunks&lt;/b&gt; (&lt;i&gt;format_timestamp_display() [MM:SS]&lt;/i&gt;, &lt;i&gt;immutable_unaccent&lt;/i&gt;, &lt;i&gt;tsv_content&lt;/i&gt;, HNSW + GIN).&lt;br/&gt;&amp;bull; Báo &lt;b&gt;READY (100%)&lt;/b&gt; qua Webhook &amp;rarr; sẵn sàng truy vấn Hybrid RRF.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;strokeWidth=2;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1253" y="316" width="375" height="150" as="geometry" />
        </mxCell>

        <!-- Connectors Band 1 -->
        <mxCell id="e-s12" value="" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s23" value="" style="endArrow=classic;html=1;strokeColor=#0D9488;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
