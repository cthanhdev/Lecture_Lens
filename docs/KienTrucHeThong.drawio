        <mxCell id="llm-hdr" value="&lt;b style=&quot;font-size:14px; color:#0F172A;&quot;&gt;🦙 Ollama&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#6B21A8;&quot;&gt;Container: llm (:11434)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
