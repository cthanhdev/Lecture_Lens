        <!-- 6 Bước ngang trong Ingest (offline) -->
        <mxCell id="ai-i1" value="&lt;b style=&quot;font-size:11px; color:#0F172A;&quot;&gt;📁 AudioStore ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;[I1] SHA-256&lt;br/&gt;manifest.json O(1)&lt;br/&gt;Chống Traversal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.2;arcSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="185" y="566" width="98" height="132" as="geometry" />
        </mxCell>
        <mxCell id="ai-i2" value="&lt;b style=&quot;font-size:11px; color:#0F172A;&quot;&gt;🎛️ FFmpeg ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;[I2] DSP Lọc nhiễu&lt;br/&gt;HP 80 / LP 7500&lt;br/&gt;afftdn + loudnorm&lt;br/&gt;&amp;rarr; 16kHz PCM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.2;arcSize=12;spacing=4;" vertex="1" parent="1">
