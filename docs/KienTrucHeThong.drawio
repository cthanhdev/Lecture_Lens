        <mxCell id="e-s56" value="" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s67" value="" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s78" value="" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- =================================================================== -->
        <!-- BAND 2: LUỒNG 2 - ONLINE 2-STAGE NEURAL RAG QUERY (STEP 9 .. STEP 14) -->
        <!-- =================================================================== -->
        <mxCell id="b2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;arcSize=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="495" width="1620" height="320" as="geometry" />
        </mxCell>
        <mxCell id="b2-hdr" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;LUỒNG 2 — ONLINE 2-STAGE NEURAL RAG &amp;amp; GROUNDED CITATION PIPELINE (STEP 9 &amp;rarr; STEP 14)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="506" width="1580" height="28" as="geometry" />
        </mxCell>

        <!-- Row 1: Step 9..11 -->
        <mxCell id="s9" value="&lt;b style=&quot;color:#991B1B; font-size:12px;&quot;&gt;Step 9: Mobile Query &amp;amp; Kiểm Quyền RBAC 🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Sinh viên đặt câu hỏi tiếng Việt (có hoặc không dấu) gửi &lt;b&gt;POST /api/v1/rag/query&lt;/b&gt; { lectureId, query, topK } kèm Bearer JWT.&lt;br/&gt;&amp;bull; Spring Boot xác thực JWT, trích lọc danh sách bài giảng hợp lệ (&lt;i&gt;authorizedLectureIds&lt;/i&gt;) &amp;rarr; chuyển tiếp &lt;b&gt;POST /internal/v1/ai/query&lt;/b&gt; kèm &lt;i&gt;X-Internal-Secret&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="544" width="500" height="118" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="&lt;b style=&quot;color:#0F766E; font-size:12px;&quot;&gt;Step 10: Query Embedding &amp;amp; Semantic Cache Check ✅/🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;BgeM3Embedder.encode_query() ✅&lt;/b&gt; nhúng câu hỏi thành &lt;i&gt;halfvec(1024)&lt;/i&gt; + &lt;i&gt;lexical_weights&lt;/i&gt;.&lt;br/&gt;&amp;bull; &lt;b&gt;rag.semantic_query_cache&lt;/b&gt; (&lt;i&gt;05_rag_telemetry_cache.sql&lt;/i&gt; ✅): tra cứu Cosine &amp;gt; &lt;b&gt;0.95&lt;/b&gt; (&amp;lt;10ms) trong luồng &lt;i&gt;/query&lt;/i&gt; chờ GĐ3 🔴.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="588" y="544" width="500" height="118" as="geometry" />
        </mxCell>

        <mxCell id="s11" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 11: GĐ1 — 3-Stream Hybrid Search RRF ✅ Code + SQL&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;ChunkStore.search_hybrid_rrf()&lt;/b&gt; (&lt;i&gt;POST /internal/v1/ai/search/hybrid&lt;/i&gt; &amp;amp; &lt;i&gt;TEST /api/search&lt;/i&gt;) gọi &lt;b&gt;rag.search_vietnamese_rag_rrf()&lt;/b&gt;:&lt;br/&gt;&amp;nbsp;&amp;nbsp;1) &lt;b&gt;Dense HNSW:&lt;/b&gt; Cosine &lt;i&gt;halfvec(1024)&lt;/i&gt; | 2) &lt;b&gt;Lexical:&lt;/b&gt; GIN &lt;i&gt;tsv_content&lt;/i&gt; | 3) &lt;b&gt;Fuzzy:&lt;/b&gt; &lt;i&gt;pg_trgm&lt;/i&gt; &amp;gt; 0.15.&lt;br/&gt;&amp;bull; Hợp nhất điểm RRF &amp;Sigma; 1/(60+rank) (có fallback &lt;i&gt;InMemoryChunkStore&lt;/i&gt; khi offline) &amp;rarr; &lt;b&gt;Top K ứng viên&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1126" y="544" width="502" height="118" as="geometry" />
        </mxCell>

        <!-- Row 2: Step 12..14 -->
        <mxCell id="s12" value="&lt;b style=&quot;color:#991B1B; font-size:12px;&quot;&gt;Step 12: GĐ2 — Cross-Encoder Reranking 🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;i&gt;(Cần code GĐ3)&lt;/i&gt; Nạp &lt;b&gt;backend/models/bge-reranker-v2-m3&lt;/b&gt; (đã tải ~2.27 GB trên đĩa ✅).&lt;br/&gt;&amp;bull; Chấm điểm tương quan cặp sâu &lt;b&gt;[Query, Chunk&lt;sub&gt;i&lt;/sub&gt;]&lt;/b&gt; cho toàn bộ Top 25 ứng viên.&lt;br/&gt;&amp;bull; Loại bỏ triệt để phân đoạn nhiễu, chỉ giữ &lt;b&gt;Top 3&amp;ndash;5 chunks&lt;/b&gt; đạt điểm cao nhất.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="684" width="500" height="116" as="geometry" />
        </mxCell>

        <mxCell id="s13" value="&lt;b style=&quot;color:#166534; font-size:12px;&quot;&gt;Step 13: Mở Rộng Ngữ Cảnh 3 Chiều ✅ Code + SQL&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;ChunkStore.get_expanded_context()&lt;/b&gt; (&lt;i&gt;GET /chunks/context/{chunk_id}&lt;/i&gt;) gọi &lt;b&gt;rag.get_expanded_context()&lt;/b&gt; (&lt;i&gt;&quot;position&quot; VARCHAR&lt;/i&gt; ✅).&lt;br/&gt;&amp;bull; Truy vết con trỏ kép &lt;i&gt;prev_chunk_id / next_chunk_id&lt;/i&gt; (&lt;i&gt;idx_chunks_nav&lt;/i&gt;) trả cụm &lt;b&gt;PREVIOUS + CURRENT + NEXT&lt;/b&gt; (~2&amp;ndash;3 phút) kèm mốc &lt;b&gt;[MM:SS]&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="588" y="684" width="500" height="116" as="geometry" />
        </mxCell>

        <mxCell id="s14" value="&lt;b style=&quot;color:#991B1B; font-size:12px;&quot;&gt;Step 14: Grounded Synthesis, Audit Log &amp;amp; Tua Audio 🔴&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10.5px; color:#1E293B;&quot;&gt;&amp;bull; Gửi Prompt &lt;b&gt;Kitsune Fox Companion&lt;/b&gt; + ngữ cảnh mở rộng tới Ollama &lt;b&gt;google/gemma-4-E4B-it&lt;/b&gt; (:11434, &lt;i&gt;temp=0.2&lt;/i&gt;) &amp;rarr; sinh câu trả lời bám ngữ cảnh kèm citation &lt;b&gt;[MM:SS]&lt;/b&gt;.&lt;br/&gt;&amp;bull; Lưu độ trễ &amp;amp; điểm vào &lt;i&gt;rag.rag_audit_logs&lt;/i&gt; + cập nhật &lt;i&gt;semantic_query_cache&lt;/i&gt; &amp;rarr; trả JSON về Mobile (&lt;b&gt;CapsuleAudioPlayer&lt;/b&gt; tua đúng mốc giờ).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;arcSize=10;spacing=7;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1126" y="684" width="502" height="116" as="geometry" />
        </mxCell>

        <!-- Connectors Band 2 -->
        <mxCell id="e-s910" value="" style="endArrow=classic;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;" edge="1" parent="1" source="s9" target="s10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s1011" value="" style="endArrow=classic;html=1;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="s10" target="s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s1112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#7C3AED;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s11" target="s12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1377" y="673" />
              <mxPoint x="300" y="673" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-s1213" value="" style="endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="s12" target="s13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s1314" value="" style="endArrow=classic;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;" edge="1" parent="1" source="s13" target="s14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- =================================================================== -->
        <!-- BAND 3: MATT POCOCK DEEP MODULES, SEAMS & UNDERSTAND ANYTHING        -->
        <!-- =================================================================== -->
        <mxCell id="b3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;arcSize=4;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="830" width="1620" height="305" as="geometry" />
        </mxCell>
        <mxCell id="b3-hdr" value="&lt;b style=&quot;font-size:13px; color:#FFFFFF;&quot;&gt;KIẾN TRÚC DEEP MODULES &amp;amp; SEAMS TRONG BACKEND/AI_SERVICE/ (MATT POCOCK + UNDERSTAND ANYTHING)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;arcSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="841" width="1580" height="28" as="geometry" />
        </mxCell>

        <mxCell id="dm1" value="&lt;b style=&quot;color:#1E3A8A; font-size:11.5px;&quot;&gt;Seam 1: AudioStoreProtocol ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#475569;&quot;&gt;core/audio_store.py&lt;/span&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;Interface:&lt;/b&gt; register, resolve_manifest, save_transcript, save_chunks, load_chunks, mark_failed&lt;br/&gt;&amp;bull; &lt;b&gt;Adapter:&lt;/b&gt; &lt;i&gt;LocalVolumeAudioStore&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Depth:&lt;/b&gt; SHA-256, chống Path Traversal, ghi nguyên tử cùng mount tránh &lt;i&gt;EXDEV&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=10;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="882" width="250" height="238" as="geometry" />
        </mxCell>

        <mxCell id="dm2" value="&lt;b style=&quot;color:#1E3A8A; font-size:11.5px;&quot;&gt;Seam 2 &amp;amp; 3: DSP, ASR &amp;amp; VAD ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#475569;&quot;&gt;preprocessing.py &amp;bull; asr.py &amp;bull; vad_chunker.py&lt;/span&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;AudioPreprocessorProtocol:&lt;/b&gt; &lt;i&gt;FFmpegAudioPreprocessor&lt;/i&gt; (16kHz Mono DSP) &amp;amp; &lt;i&gt;FakeAudioPreprocessor&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;AsrEngineProtocol:&lt;/b&gt; &lt;i&gt;PhoWhisperEngine&lt;/i&gt; + &lt;i&gt;unload()&lt;/i&gt; &amp;amp; &lt;i&gt;FakeAsrEngine&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;VadChunkerProtocol:&lt;/b&gt; &lt;i&gt;EnergyVadChunker&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=10;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="316" y="882" width="250" height="238" as="geometry" />
        </mxCell>

        <mxCell id="dm3" value="&lt;b style=&quot;color:#1E3A8A; font-size:11.5px;&quot;&gt;Seam 4: TextChunker [I5] ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#475569;&quot;&gt;core/text_chunker.py&lt;/span&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;TokenizerProtocol:&lt;/b&gt; &lt;i&gt;BgeM3TokenizerAdapter&lt;/i&gt; &amp;amp; &lt;i&gt;WhitespaceApproxTokenizer&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;TextChunkerProtocol:&lt;/b&gt; &lt;i&gt;RecursiveTokenChunker&lt;/i&gt; (&amp;le;512 tokens, 64 overlap)&lt;br/&gt;&amp;bull; &lt;b&gt;Depth:&lt;/b&gt; tách câu đệ quy, nội suy &lt;i&gt;[MM:SS]&lt;/i&gt;, &lt;i&gt;prev/next_chunk_id&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=10;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="582" y="882" width="250" height="238" as="geometry" />
        </mxCell>

        <mxCell id="dm4" value="&lt;b style=&quot;color:#1E3A8A; font-size:11.5px;&quot;&gt;Seam 5: EmbedderProtocol [I6] ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#475569;&quot;&gt;core/embedder.py&lt;/span&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;Interface:&lt;/b&gt; encode_passages, encode_query, unload&lt;br/&gt;&amp;bull; &lt;b&gt;Prod Adapter:&lt;/b&gt; &lt;i&gt;BgeM3Embedder&lt;/i&gt; nạp trực tiếp &lt;i&gt;transformers&lt;/i&gt; + &lt;i&gt;sparse_linear.pt&lt;/i&gt; (không dùng &lt;i&gt;FlagEmbedding&lt;/i&gt;)&lt;br/&gt;&amp;bull; &lt;b&gt;Output:&lt;/b&gt; &lt;i&gt;halfvec(1024)&lt;/i&gt; FP16 L2 + &lt;i&gt;lexical_weights&lt;/i&gt; JSONB; &lt;i&gt;FakeEmbedder&lt;/i&gt; cho tests.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=10;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="848" y="882" width="250" height="238" as="geometry" />
        </mxCell>

        <mxCell id="dm5" value="&lt;b style=&quot;color:#1E3A8A; font-size:11.5px;&quot;&gt;Seam 6: ChunkStoreProtocol ✅&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px; color:#475569;&quot;&gt;core/chunk_store.py&lt;/span&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#1E293B;&quot;&gt;&amp;bull; &lt;b&gt;Interface:&lt;/b&gt; save_lecture_chunks, get_lecture_chunks, search_hybrid_rrf, get_expanded_context&lt;br/&gt;&amp;bull; &lt;b&gt;Adapters:&lt;/b&gt; &lt;i&gt;PostgresPgVectorChunkStore&lt;/i&gt; (HNSW + TSV + pg_trgm), &lt;i&gt;InMemoryChunkStore&lt;/i&gt; (fallback offline), &lt;i&gt;CompositeChunkStore&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;arcSize=10;spacing=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1114" y="882" width="250" height="238" as="geometry" />
        </mxCell>

