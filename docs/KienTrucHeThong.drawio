        <!-- Đường phản hồi vòng trái: Báo xử lý xong -->
        <mxCell id="edge-left-done" value="&lt;b&gt;Báo xử lý&lt;br/&gt;xong&lt;/b&gt;&lt;br/&gt;(STT_COMPLETED&lt;br/&gt;/ READY)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1E293B;strokeWidth=2;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="ing-box" target="u-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="72" y="628" />
              <mxPoint x="72" y="114" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Đường phản hồi vòng phải: Trả lời kèm nguồn -->
        <mxCell id="edge-right-ans" value="&lt;b&gt;Trả lời&lt;br/&gt;kèm nguồn&lt;/b&gt;&lt;br/&gt;({ answer,&lt;br/&gt;citations [MM:SS] })" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=classic;html=1;strokeColor=#1E293B;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="llm-gemma" target="c-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1605" y="652" />
              <mxPoint x="1605" y="114" />
