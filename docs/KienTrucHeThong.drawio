        <mxCell id="llm-gemma" value="&lt;b style=&quot;font-size:12px; color:#991B1B;&quot;&gt;✨ Gemma 4 E4B 🔴&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px; color:#0F172A;&quot;&gt;&lt;b&gt;Sinh trả lời&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155;&quot;&gt;&amp;bull; Model: &lt;i&gt;google/gemma-4-E4B-it&lt;/i&gt;&lt;br/&gt;&amp;bull; Config: &lt;i&gt;temp=0.2, repeat_penalty=1.15&lt;/i&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Grounding Prompt:&lt;/b&gt; Kitsune Fox Companion, chỉ dùng ngữ cảnh bài giảng, bắt buộc dẫn nguồn &lt;b&gt;[MM:SS]&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.5;dashed=1;arcSize=12;spacing=6;verticalAlign=top;" vertex="1" parent="1">
