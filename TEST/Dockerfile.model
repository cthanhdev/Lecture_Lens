# =========================================================================
# LectureLens Model Runner & Test Studio Dockerfile
# Provides PhoWhisper ASR + BGE-M3 + pgvector Client + FastAPI Test UI
# =========================================================================
FROM python:3.10-slim

# Install system dependencies, FFmpeg audio codecs, and PostgreSQL client libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install shared backend dependencies (torch, transformers, psycopg2-binary, etc.)
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy backend source & fixtures (models are mounted read-only at runtime)
COPY backend/ai_service/ /app/backend/ai_service/
COPY backend/tests/fixtures/ /app/backend/tests/fixtures/
COPY TEST/ /app/TEST/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend:/app \
    PORT=8090 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    TORCH_NUM_THREADS=4 \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app/TEST

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8090}/api/system-diagnostics" || exit 1

CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8090"]
