# =========================================================================
# LectureLens Model Runner & Test Studio Dockerfile
# Provides PhoWhisper ASR + FFmpeg + FastAPI Test UI
# =========================================================================
FROM python:3.10-slim

# Install system dependencies & FFmpeg with audio codecs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch & ASR dependencies
RUN pip install --no-cache-dir \
    fastapi>=0.111.0 \
    uvicorn[standard]>=0.30.0 \
    pydantic>=2.7.0 \
    pydantic-settings>=2.3.0 \
    httpx>=0.27.0 \
    python-multipart>=0.0.9 \
    soundfile>=0.12.1 \
    numpy>=1.24.0 \
    imageio-ffmpeg \
    torch \
    transformers>=4.40.0

# Copy application code preserving repository structure
COPY backend/ /app/backend/
COPY TEST/ /app/TEST/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend:/app \
    PORT=8090

WORKDIR /app/TEST

EXPOSE 8090

CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8090"]
