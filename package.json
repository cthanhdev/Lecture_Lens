{
  "name": "lecturelens-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "LectureLens - AI Lecture Summarization & Flashcard App",
  "scripts": {
    "start": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
