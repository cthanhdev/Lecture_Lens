# ==========================================
# LectureLens Backend - Environment Variables
# ==========================================

# Spring Boot Gateway Configuration
SPRING_PORT=8080
SPRING_BASE_URL=http://spring:8080
JWT_SECRET=super_secret_jwt_lecturelens_key_2026_at_least_256_bits
INTERNAL_API_SECRET_KEY=lecture_lens_internal_secret_token_xyz987
FASTAPI_INTERNAL_URL=http://ai:8000

# Shared Storage Volume
STORAGE_ROOT=/volumes/rag_data

# PostgreSQL + pgvector Configuration
POSTGRES_DB=lecturelens_db
POSTGRES_USER=ll_admin
POSTGRES_PASSWORD=ll_secure_password_2026
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://llm:11434
OLLAMA_MODEL=gemma-4-e4b

# AI Service Hardware & Threading Optimization
# Sized for 16 vCPU / 16 GB RAM / 4 GB VRAM (RTX 3050 Laptop)
DEVICE=auto
LOW_VRAM_MODE=true
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4

# Local On-Premise Model Paths (inside Docker container: /models/*)
MODEL_PATH_PHOWHISPER=/models/phowhisper-base
MODEL_PATH_BGE_M3=/models/bge-m3
MODEL_PATH_RERANKER=/models/bge-reranker-v2-m3
MODEL_PATH_GEMMA=/models/gemma-4-e4b
